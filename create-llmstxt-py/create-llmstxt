#!/usr/bin/env bash
# Wrapper: runs generate-llmstxt.py with the project venv from any directory.
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="$DIR/.venv/bin/python"
[[ -x "$PY" ]] || { echo "venv missing, run: $DIR/install.sh" >&2; exit 1; }
exec "$PY" "$DIR/generate-llmstxt.py" "$@"
